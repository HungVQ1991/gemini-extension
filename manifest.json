{
  "manifest_version": 3,
  "name": "Gemini Power Suite | Personal Edition",
  "version": "2.0.0",
  "minimum_chrome_version": "111",
  "description": "Personal productivity suite for Google Gemini: Folders, Message Queue, Prompt Library, Wide Mode, and Export.",
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "open-gemini": {
      "suggested_key": {
        "default": "Alt+G"
      },
      "description": "Open Gemini App"
    }
  },
  "content_scripts": [
    {
      "js": [
        "spoof_injector.js"
      ],
      "matches": [
        "https://gemini.google.com/*"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "css": [
        "content.css"
      ],
      "js": [
        "content/core-namespace.js",
        "content/selectors.js",
        "content/dispatcher.js",
        "content/runtime-bus.js",
        "content/legacy-core-export.js",
        "content/legacy-composer-optimizer.js",
        "content/legacy-queue-chains.js",
        "content/legacy-sidebar-autohide.js",
        "content/legacy-folders-prompts.js",
        "content/legacy-pinned-drag-export.js",
        "content/legacy-slash-drive.js",
        "content/folder-uploader.js",
        "content/skills-core.js",
        "content/skills-migration-ui.js",
        "content/outline-export.js",
        "content/code-blocks.js",
        "content/command-palette.js",
        "content/orchestrator.js",
        "content/periodic-table.js",
        "content/diagram-renderer.js"
      ],
      "matches": [
        "https://gemini.google.com/*"
      ],
      "run_at": "document_end"
    }
  ],
  "host_permissions": [
    "https://gemini.google.com/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "optional_permissions": [
    "identity"
  ],
  "permissions": [
    "tabs",
    "storage",
    "scripting",
    "alarms"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "web_accessible_resources": [
    {
      "matches": [
        "https://gemini.google.com/*"
      ],
      "resources": [
        "content.css",
        "icons/icon48.png",
        "icons/icon128.png",
        "guide.html",
        "diagram-sandbox.html",
        "diagram-sandbox.js",
        "diagram-sandbox.css",
        "lib/diagrams/*"
      ]
    }
  ]
}
