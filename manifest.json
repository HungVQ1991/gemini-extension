{
  "manifest_version": 3,
  "name": "Gemini Power Suite | Personal Edition",
  "version": "1.0.0",
  "minimum_chrome_version": "111",
  "description": "Personal productivity suite for Google Gemini: Folders, Message Queue, Prompt Library, Wide Mode, and Export.",
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "open-gemini": {
      "suggested_key": {
        "default": "Alt+G"
      },
      "description": "Open Gemini App"
    }
  },
  "content_scripts": [
    {
      "js": [
        "spoof_injector.js"
      ],
      "matches": [
        "https://gemini.google.com/*"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "css": [
        "content.css"
      ],
      "js": [
        "content.js"
      ],
      "matches": [
        "https://gemini.google.com/*"
      ],
      "run_at": "document_end"
    }
  ],
  "host_permissions": [
    "https://gemini.google.com/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "optional_permissions": [
    "identity"
  ],
  "permissions": [
    "tabs",
    "storage",
    "scripting"
  ],
  "web_accessible_resources": [
    {
      "matches": [
        "https://gemini.google.com/*"
      ],
      "resources": [
        "content.css",
        "icons/icon48.png",
        "icons/icon128.png",
        "guide.html"
      ]
    }
  ]
}
